{
  "compilerOptions": {
    "target": "es2022",
    "experimentalDecorators": true,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "dist",
    "module": "NodeNext",
    "lib": ["ES2021"],
    "typeRoots": ["./node_modules/@types", "./src/types", "./types"]
  },
  "include": ["**/*.ts", "non-prod.config.js"],
  "exclude": ["node_modules", "test/**/*.test.ts"]
}
